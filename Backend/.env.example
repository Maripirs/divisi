DATABASE_URL=postgresql+psycopg2://divisi:divisi@localhost:5432/divisi
JWT_SECRET=dev-secret-change-me
STORAGE_DIR=./data/storage

# Neon Object Storage (S3-compatible) — durable home for user uploads.
# Leave unset to keep everything on local disk (STORAGE_DIR). To enable,
# create a storage credential on the branch (Neon Console -> Branch ->
# Credentials, scopes storage:read + storage:write) and paste its values:
# AWS_ENDPOINT_URL_S3=https://<branch>.storage.<...>.aws.neon.tech
# AWS_ACCESS_KEY_ID=nak_live_...
# AWS_SECRET_ACCESS_KEY=nsk_live_...
# AWS_REGION=us-east-2
# S3_BUCKET=uploads
