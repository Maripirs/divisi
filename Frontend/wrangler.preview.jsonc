{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Preview-only config, deliberately not committed: a distinct Worker name
	// with no `routes`/custom_domain block, so it publishes to Cloudflare's
	// own `<name>.<account>.workers.dev` subdomain and can never collide with
	// or reassign the real `divisi-frontend` Worker's `divisi.maripi.net`
	// custom domain mapping.
	"name": "divisi-frontend-preview",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	}
}
