# Base URL of the Divisi Backend API (see Backend/plan.md). Local dev
# defaults to a Backend running on its docker-compose port. Copy this to
# `.env` (or override in `.env.local`) for local work.
#
# Production builds do NOT use this: `vite build` reads the committed
# `.env.production`, which wins over `.env`/`.env.local`.
PUBLIC_API_BASE_URL=http://localhost:8000

# F35 (Carpool Map): Google Maps JavaScript API key and, optionally, a Map
# ID (for cloud-based map styling / Advanced Markers). Neither is set
# anywhere in this repo as of this writing, and that's fine: the whole
# carpool map feature is built to degrade gracefully to today's text-only,
# no-map board with zero console errors whenever these are unset, see
# `$lib/utils/googleMaps.ts`. Unlike `PUBLIC_API_BASE_URL` above, these are
# read via `$env/dynamic/public` (not `$env/static/public`), specifically
# so an unset key doesn't fail `svelte-check`/`vite build` at all: a static
# import of an env var that's never defined anywhere throws at build time,
# which is exactly the failure mode this feature must never hit while no
# key is configured.
#
# Once a real key exists, restrict it by HTTP referrer and enable only the
# Maps JavaScript API + Places API in Google Cloud Console before setting
# it here (see plan.md's "Maps Integration Architecture" section). Because
# this project deploys via a manual `wrangler deploy` rather than a
# `.env.production` build-time bake (see the Frontend deploy-ops notes),
# a production value for these two also needs to be added to Cloudflare
# (wrangler `vars`, or a dashboard-set Worker environment variable), not
# just to a local `.env`/`.env.local`.
PUBLIC_GOOGLE_MAPS_API_KEY=
PUBLIC_GOOGLE_MAPS_MAP_ID=
