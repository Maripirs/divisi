# Base URL of the Divisi Backend API (see Backend/plan.md). Local dev
# defaults to a Backend running on its docker-compose port. Copy this to
# `.env` (or override in `.env.local`) for local work.
#
# Production builds do NOT use this: `vite build` reads the committed
# `.env.production`, which wins over `.env`/`.env.local`.
PUBLIC_API_BASE_URL=http://localhost:8000
