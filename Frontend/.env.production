# Committed. Loaded only by `vite build` (mode=production), and it beats
# `.env` AND `.env.local` in Vite's precedence order, so a local `.env.local`
# pointing at localhost can no longer leak into a production bundle.
# Local dev (`vite dev`, mode=development) does not load this file.
PUBLIC_API_BASE_URL=https://divisi.onrender.com
