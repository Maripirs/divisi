# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Playwright (e2e): the saved login session (holds a real login token, never
# commit it) and all run artifacts stay local; the config + specs + helpers
# are committed.
/e2e/.auth
/test-results
/playwright-report
/blob-report
/playwright/.cache

# pdfjs runtime assets — copied out of node_modules/pdfjs-dist by an inline
# plugin in vite.config.ts on every dev/build (see PdfView.svelte)
/static/pdfjs

# i18n: generated by @inlang/paraglide-js (vite.config.ts) from
# project.inlang/ + messages/*.json — regenerated on every build/dev start
src/lib/paraglide
